# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:8000

# LLM Provider (deepseek, mistral)
LLM_PROVIDER=deepseek

# API Keys (at least one LLM key; ANTHROPIC_API_KEY is also required by npm run analyze)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Game Configuration
AI_COUNT=3

# Postgres — optional locally: without it the game runs and nothing is persisted.
# Local persistence: createdb turingarou, then uncomment.
# DATABASE_URL=postgres://localhost/turingarou

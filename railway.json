{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd turingarou-backend && npm ci --include=dev && npm run build",
    "watchPatterns": ["**", "!**/*.md", "!/specs/**"]
  },
  "deploy": {
    "startCommand": "cd turingarou-backend && npm start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
